Run.Description Commensurate twisted-bilayer graphene band structure
Run.Prefix generate

Run.TypeOfSystem TwistedBilayerBasedOnMoireCell
Interlayer.TypeOfBL Koshino

Structure.MoireCellParameters 3 2 2 3
Structure.SuperCell 1
Stack.TwoLayers .true.
Stack.TwoLayersZ1 18.33
Stack.TwoLayersZ2 21.67
Structure.InterlayerDistance 3.34
Structure.CellHeight 40.0

Kubo.Calc .false.
Diag.Calc .true.
Calculate.Bands .true.

Bands.NumPoints 12
&begin Bands.Path 4
2/3  1/3  0.0  # K
0.0  0.0  0.0  # Gamma
0.5  0.0  0.0  # M
2/3  1/3  0.0  # K'
&end Bands.Path

Neigh.fastNNnotsquare .true.
Neigh.LayerNeighbors 100
Neigh.LayerDistFactor 6.2

# Intralayer model: nearest-neighbor hopping only (one neighbor shell).
# TB.NeighLevels 5 selects the full F2G2 intralayer model instead, which gives
# different bands and has no reference data here.
TB.NeighLevels 1

Output.WriteDataFiles .false.
WritePos .false.
