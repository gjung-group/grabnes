# Intel Fortran (classic ifort) + Intel MPI + MKL configuration, with OpenMP.
#
# Use it with:  ./grabnes_testrun/run_examples.sh --make-sys grabnes_testrun/config/intel.make.sys
# The Intel compiler, MPI, and MKL environments must be loaded (for example
# with the oneAPI setvars.sh script or the site's environment modules).
# ARPACK is taken from the system; add -L<dir> to LIBS if it is elsewhere.

F90 = mpiifort
F90_SERIAL = ifort
FCFLAGS = -O2 -g -traceback -DMPI -qopenmp -DPOINTER_SIZE=8
ARFLAGS = rc

INCFLAGS =
LIBS = -larpack -qmkl=sequential
LDFLAGS = -qopenmp
