#=================================================
#
# Linux platform
# Compiler: GNU Fortran
# Parallel mode
# 
#=================================================

F90 = mpif90
F90_SERIAL=gfortran
FCFLAGS = -O3 -g -DMPI -DDEBUG -fopenmp -DPOINTER_SIZE=8
ARFLAGS = rc

SPRNGROOT=/home/rafael/Programs/sprng4
INCFLAGS=-I$(SPRNGROOT)/include
LIBSPRNG=-lsprng
LIBMPI=-lmpi_cxx -lmpi -lstdc++

LIBBLAS = -lblas
LIBLAPACK = -llapack
LIBSCALAPACK =

LIBS = $(LIBMPI) $(LIBSPRNG) $(LIBBLAS) $(LIBLAPACK) $(LIBSCALAPACK) -lgomp