#=================================================
#
# Linux platform
# Compiler: Intel
# Parallel mode
# 
#=================================================

OMPI_ROOT=/share/apps/openmpi-1.4-intel

F90 = $(OMPI_ROOT)/bin/mpif90
F90_SERIAL=ifort
#FCFLAGS = -O1 -DMPI -DDEBUG -openmp -DPOINTER_SIZE=8 -g -traceback -check all -fp-stack-check
FCFLAGS = -O3 -DMPI -DDEBUG -openmp -DPOINTER_SIZE=8 -g
ARFLAGS = rc

EXTRA_LIBS=-liomp5
SPRNGROOT=/home/rmartinez/builds/sprng4-intel
INCSPRNG=-I$(SPRNGROOT)/include
LIBSPRNG=$(SPRNGROOT)/lib/libsprng.a
LIBMPI=-I/opt/openmpi/include -L/opt/openmpi/lib -lmpi_cxx -lmpi -lopen-rte -lopen-pal -ldl -Wl,--export-dynamic -lnsl -lutil -lm -ldl

INCMKL=-I$(MKLROOT)/include/intel64/lp64 -I$(MKLROOT)/include
LIBBLAS = $(MKLROOT)/lib/intel64/libmkl_blas95_lp64.a
LIBLAPACK = $(MKLROOT)/lib/intel64/libmkl_lapack95_lp64.a -Wl,--start-group $(MKLROOT)/lib/intel64/libmkl_sequential.a $(MKLROOT)/lib/intel64/libmkl_intel_lp64.a $(MKLROOT)/lib/intel64/libmkl_core.a -Wl,--end-group -lpthread

INCFLAGS=$(INCMKL) $(INCSPRNG)

LIBS = $(LIBMPI) $(LIBSPRNG)  \
       $(LIBLAPACK) $(LIBBLAS) \
       $(EXTRA_LIBS)
