#=================================================
#
# Linux platform
# Compiler: GNU Fortran
# Serial mode
# 
#=================================================

F90 = gfortran
F90_SERIAL=gfortran
FCFLAGS = -O0 -g -DDEBUG
ARFLAGS = rc

LIBBLAS = -lblas
LIBLAPACK = -llapack
LIBSCALAPACK =

LIBS = $(LIBBLAS) $(LIBLAPACK) $(LIBSCALAPACK)